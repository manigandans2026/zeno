# ==========================================
# ZUNO CONFIGURATION TEMPLATE
# ==========================================

# ------------------------------------------
# Frontend Variables (Vite - Public)
# ------------------------------------------
# Supabase Project URL (Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Project Settings > API)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Custom backend API URL in production (if separate from Vercel)
VITE_API_URL=

# ------------------------------------------
# Backend Server Variables (Server-Only, Never Expose to Client)
# ------------------------------------------
# Node Server Port
PORT=5000

# OpenRouter API Key for AI Assistant Suite (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-api-key

# OpenRouter Model identifier (Default: google/gemini-2.0-flash-001 or meta-llama/llama-3.3-70b-instruct)
OPENROUTER_MODEL=deepseek/deepseek-chat

# Supabase Service Role Key (Used only on server for admin operations & auth overrides)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Frontend URL for CORS (e.g., https://your-zuno-app.vercel.app or http://localhost:5173)
FRONTEND_URL=http://localhost:5173
